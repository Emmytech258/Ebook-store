{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebook-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [],
  "vars": {
    "PUBLIC_ORIGIN": "https://store.example.invalid"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ebook-store",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ebook-files"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
